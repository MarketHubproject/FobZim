# ZimBuzz Production Environment Configuration
# Copy this file to .env and replace with your actual Firebase values

# 🔥 Firebase Configuration
# Get these from: Firebase Console > Project Settings > General > Your apps > Config
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# 🛠️ Development Configuration
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_ENVIRONMENT=production

# 📱 App Configuration  
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_API_URL=https://your-api.com
EXPO_PUBLIC_APP_NAME=ZimBuzz

# 🇿🇼 Zimbabwe Specific
EXPO_PUBLIC_DEFAULT_CURRENCY=USD
EXPO_PUBLIC_DEFAULT_LOCATION=Zimbabwe
EXPO_PUBLIC_SUPPORTED_LANGUAGES=en,sn,nd

# 🔔 Notification Configuration
EXPO_PUBLIC_EXPO_PROJECT_ID=your-expo-project-id

# Example values for testing (replace with your actual values):
# EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=zimbuzz-prod.firebaseapp.com
