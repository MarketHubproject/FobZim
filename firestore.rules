rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isModerator(resource) {
      return isAuthenticated() && 
        request.auth.uid in resource.data.moderators;
    }
    
    function hasValidUserProfile() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Users collection - user profiles
    match /users/{userId} {
      // Users can read their own profile and other public profiles
      allow read: if isAuthenticated();
      
      // Users can only write to their own profile
      allow write: if isOwner(userId) && hasValidUserProfile();
      
      // Admins can read/write all user profiles
      allow read, write: if isAdmin();
    }
    
    // Creators collection - public creator profiles
    match /creators/{creatorId} {
      // Anyone can read creator profiles (public data)
      allow read: if true;
      
      // Only the creator themselves can update their profile
      allow write: if isOwner(creatorId);
      
      // Admins can manage creator profiles
      allow write: if isAdmin();
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      // Anyone can read public campaigns
      allow read: if resource.data.visibility == 'public' || 
                    (isAuthenticated() && (
                      resource.data.visibility == 'invited' && 
                      request.auth.uid in resource.data.participantIds
                    )) ||
                    resource.data.visibility == 'region_locked';
      
      // Campaign owners can read their private campaigns
      allow read: if isAuthenticated() && 
                    resource.data.createdBy == request.auth.uid;
                    
      // Moderators can read campaigns they moderate
      allow read: if isAuthenticated() && 
                    request.auth.uid in resource.data.moderators;
      
      // Only authenticated users can create campaigns
      allow create: if isAuthenticated() && 
                      request.auth.uid == request.resource.data.createdBy &&
                      hasValidUserProfile();
      
      // Campaign owners and moderators can update campaigns
      allow update: if isAuthenticated() && 
                      (request.auth.uid == resource.data.createdBy ||
                       request.auth.uid in resource.data.moderators);
      
      // Only campaign owners can delete campaigns
      allow delete: if isAuthenticated() && 
                      request.auth.uid == resource.data.createdBy;
      
      // Admins can manage all campaigns
      allow read, write: if isAdmin();
      
      // Campaign updates subcollection
      match /updates/{updateId} {
        // Anyone can read updates for public campaigns
        allow read: if true;
        
        // Campaign moderators can create updates
        allow create: if isAuthenticated() && 
                        request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.moderators;
        
        // Update authors can edit their own updates
        allow update: if isAuthenticated() && 
                        request.auth.uid == resource.data.createdBy;
        
        // Campaign owners can delete updates
        allow delete: if isAuthenticated() && 
                        (request.auth.uid == resource.data.createdBy ||
                         request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.moderators);
      }
    }

    // Contributions collection
    match /contributions/{contributionId} {
      // Contributors can read their own contributions
      allow read: if isAuthenticated() && 
                    request.auth.uid == resource.data.contributorId;
      
      // Campaign owners can read contributions to their campaigns
      allow read: if isAuthenticated() && 
                    request.auth.uid == get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId)).data.createdBy;
      
      // Only authenticated users can create contributions
      allow create: if isAuthenticated() && 
                      request.auth.uid == request.resource.data.contributorId &&
                      hasValidUserProfile();
      
      // Contributors can update their own contributions (for status changes)
      allow update: if isAuthenticated() && 
                      request.auth.uid == resource.data.contributorId;
      
      // Admins can manage all contributions
      allow read, write: if isAdmin();
    }

    // Conversations collection - messaging
    match /conversations/{conversationId} {
      // Participants can read/write conversations they're part of
      allow read, write: if isAuthenticated() && 
                           request.auth.uid in resource.data.participants;
      
      // Allow creation if user is one of the participants
      allow create: if isAuthenticated() && 
                      request.auth.uid in request.resource.data.participants &&
                      hasValidUserProfile();
      
      // Messages subcollection
      match /messages/{messageId} {
        // Conversation participants can read messages
        allow read: if isAuthenticated() && 
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Authenticated users can send messages to conversations they participate in
        allow create: if isAuthenticated() && 
                        request.auth.uid == request.resource.data.senderId &&
                        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Message senders can update their own messages (for editing)
        allow update: if isAuthenticated() && 
                        request.auth.uid == resource.data.senderId;
        
        // Message senders can delete their own messages
        allow delete: if isAuthenticated() && 
                        request.auth.uid == resource.data.senderId;
      }
    }

    // Tips collection - daily tips for creators
    match /tips/{tipId} {
      // Anyone can read tips
      allow read: if true;
      
      // Only admins and moderators can manage tips
      allow write: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && 
                    request.auth.uid == resource.data.userId;
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
                      request.auth.uid == resource.data.userId;
      
      // System can create notifications (server-side or admin)
      allow create: if isAdmin();
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && 
                      request.auth.uid == resource.data.userId;
    }

    // Analytics collection - for storing aggregated data
    match /analytics/{analyticsId} {
      // Only admins can read analytics
      allow read: if isAdmin();
      
      // Only system/admin can write analytics
      allow write: if isAdmin();
    }

    // Admin collection - for admin user management
    match /admins/{adminId} {
      // Only admins can read admin list
      allow read: if isAdmin();
      
      // Only existing admins can manage admin list
      allow write: if isAdmin();
    }

    // Moderators collection
    match /moderators/{moderatorId} {
      // Admins can manage moderators
      allow read, write: if isAdmin();
      
      // Users can read to check if they're moderators
      allow read: if isAuthenticated();
    }

    // Push tokens collection - for notification delivery
    match /pushTokens/{tokenId} {
      // Users can manage their own push tokens
      allow read, write: if isAuthenticated() && 
                           request.auth.uid == resource.data.userId;
      
      // System can read all tokens for sending notifications
      allow read: if isAdmin();
    }

    // Reports collection - for content moderation
    match /reports/{reportId} {
      // Users can create reports
      allow create: if isAuthenticated() && 
                      request.auth.uid == request.resource.data.reportedBy &&
                      hasValidUserProfile();
      
      // Users can read their own reports
      allow read: if isAuthenticated() && 
                    request.auth.uid == resource.data.reportedBy;
      
      // Admins can manage all reports
      allow read, write: if isAdmin();
    }

    // Block all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}